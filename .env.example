DATABASE_URL=postgresql+asyncpg://commerce:commerce_dev_password@localhost:5432/commerce_intelligence
REDIS_URL=redis://localhost:6379/0

# Optional. Without this key, pages containing Product/ItemList JSON-LD
# are still scraped deterministically; AI extraction is used for other pages.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
